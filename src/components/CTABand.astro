---
interface CTA {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  primary: CTA;
  secondary?: CTA;
}

const { eyebrow, title, description, primary, secondary } = Astro.props;
---

<section class="section section--ink cta-band">
  <div class="container cta-band__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    {description && <p class="lede">{description}</p>}
    <div class="btn-row cta-band__actions">
      <a class="btn btn--primary" href={primary.href}>{primary.label}</a>
      {secondary && (
        <a class="btn btn--secondary" href={secondary.href}>{secondary.label}</a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-band__inner {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .cta-band__actions {
    margin-top: var(--space-3);
    justify-content: center;
  }
</style>
