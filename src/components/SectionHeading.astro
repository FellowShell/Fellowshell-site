---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  align?: "left" | "center";
  as?: "h2" | "h1";
}

const { eyebrow, title, lede, align = "left", as = "h2" } = Astro.props;
const Tag = as;
---

<div class={`section-heading section-heading--${align}`}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag>{title}</Tag>
  {lede && <p class="lede">{lede}</p>}
</div>

<style>
  .section-heading {
    max-width: 40rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .section-heading--center {
    margin-inline: auto;
    text-align: center;
    align-items: center;
  }
</style>
