---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CTABand from "../components/CTABand.astro";

const values = [
  {
    title: "Training comes first",
    description:
      "No one touches client work before going through Fellowshell's onboarding, whatever their starting level.",
  },
  {
    title: "Managed, not just matched",
    description:
      "An account lead stays engaged for the life of the placement, overseeing quality and progress throughout.",
  },
  {
    title: "Real work over busywork",
    description:
      "Only genuine, meaningful work gets sent to volunteers, so the experience they build actually counts for something.",
  },
  {
    title: "We take the structure seriously",
    description:
      "Data protection, accessibility, and how the program itself is set up are treated as core to the model, not an afterthought.",
  },
];
---

<BaseLayout
  title="About"
  description="Fellowshell is a consulting and talent pipeline that trains volunteers and manages them on real client work."
>
  <section class="section">
    <div class="container hero-copy">
      <p class="eyebrow">About Fellowshell</p>
      <h1>A training pipeline that respects both sides of the table.</h1>
      <p class="lede">
        Fellowshell exists to connect two things that don't usually meet:
        people who want real experience, and companies with real work to do.
        We train and manage the volunteers, so companies get genuine capacity
        and volunteers get a genuine start.
      </p>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <SectionHeading eyebrow="What we believe" title="The principles behind how we operate" />
      <div class="grid grid--2">
        {values.map((value) => (
          <div class="card">
            <h3>{value.title}</h3>
            <p class="text-muted">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <SectionHeading eyebrow="Leadership" title="Who's behind Fellowshell" />
      <div class="card leadership-card">
        <p class="text-muted">
          [Add a short founder bio here before launch. A first name and a
          line on your background is enough, no legal name required.]
        </p>
      </div>
    </div>
  </section>

  <CTABand
    title="Want to know more before you reach out?"
    description="Happy to walk through how the program works, on either side of the table."
    primary={{ label: "Get in touch", href: "/contact" }}
    secondary={{ label: "See how it works for companies", href: "/services" }}
  />
</BaseLayout>

<style>
  .hero-copy {
    max-width: 42rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .leadership-card {
    text-align: center;
  }
</style>
